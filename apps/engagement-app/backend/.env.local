# Engagement App Backend: local settings template. Copy to .env (git-ignored)
# and fill in. ENGAGEMENT_ENTITY_BASE_URL, JWT_AUDIENCES and EMAIL_SERVICE_URL
# (or EMAIL_DISABLED=true) are required to start; each
# other service is optional locally (its screens answer 503 until it is set).
# Never commit real values.

# --- Required ---------------------------------------------------------------
# The Engagement Entity started by run-local.sh.
ENGAGEMENT_ENTITY_BASE_URL=http://localhost:8290

# One WSO2 dev server (localhost:3000) calls the backend from the browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# One WSO2 client id: the token's aud must contain it.
JWT_AUDIENCES=

# --- Outbound WSO2 services (one shared client-credentials pair) -------------
# Legacy key: [app_allocation.entity.clientAuthConfig] clientId / clientSecret.
OUTBOUND_CLIENT_ID=
OUTBOUND_CLIENT_SECRET=
# Scopes requested in the outbound token (comma or space separated); blank
# requests none. Must cover every subscribed API that enforces scopes.
OUTBOUND_SCOPES=
# Go Sales Entity Service (accounts, opportunities, line items, campaigns).
SALES_ENTITY_BASE_URL=
# HR Entity GraphQL. Legacy key: [app_allocation.entity] hrEntityEndpoint.
HR_ENTITY_URL=

# --- Optional ----------------------------------------------------------------
# Email. EMAIL_DISABLED=true logs instead of sending. See README for the list.
EMAIL_DISABLED=true
# EMAIL_SERVICE_URL=
# IS_LIVE_EMAILS=false
# EMAIL_TEST_RECIPIENTS=
# Legacy currency conversion service (unset: per diem payment add/edit 503).
# CURRENCY_CONVERT_SERVICE_URL=
# Staging visa sentinel ids (production defaults 332 / 333).
# TRAVEL_VISA_NOT_APPLICABLE_ID=40
# TRAVEL_NO_VALID_VISA_ID=41
# Passport and visa images (unset: uploads and downloads answer 503).
# FILE_STORAGE_ACCOUNT=
# FILE_STORAGE_ACCESS_KEY=
