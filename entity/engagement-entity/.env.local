# Engagement Entity: local settings template. Copy to .env (git-ignored) and
# fill in. Only DB_HOST, DB_USER and DB_PASSWORD are required; everything
# else has a safe default. Never commit real values.

# --- Required ---------------------------------------------------------------
# MySQL host of the legacy schemas (allocation_db and travelapp read/write,
# expense_app read-only). One user for all three.
DB_HOST=
DB_USER=
DB_PASSWORD=

# --- Optional (defaults shown) ------------------------------------------------
# DB_PORT=3306
# Empty = verified TLS. Set false only for a local MySQL without TLS.
# DB_TLS=
# SERVER_PORT=8290

# --- NetSuite (only when switched on) -----------------------------------------
# Off: invoice and per diem pushes and re-syncs answer 503, entry duplicate
# checks skip NetSuite, and a new Marketing Event is saved without a NetSuite
# marketing event (a warning is logged).
# NETSUITE_PUSH_ENABLED=false
# NETSUITE_ACCOUNT_ID=
# NETSUITE_CONSUMER_KEY=
# NETSUITE_CONSUMER_SECRET=
# NETSUITE_TOKEN_ID=
# NETSUITE_TOKEN_SECRET=
# NETSUITE_PURCHASE_ORDER_TAX_CODE=
# NETSUITE_CREATE_PURCHASE_ORDER_SCRIPT_ID=
# NETSUITE_GET_PURCHASE_ORDER_SCRIPT_ID=
# NETSUITE_CREATE_VENDOR_BILL_SCRIPT_ID=
# NETSUITE_GET_VENDOR_BILL_SCRIPT_ID=
# NETSUITE_CREATE_MARKETING_EVENT_SCRIPT_ID=
# Optional: NETSUITE_RESTLETS_BASE_URL (default from the account id) and
# NETSUITE_*_DEPLOY_ID for each script (default 1).
