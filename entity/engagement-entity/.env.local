# Engagement Entity: local settings template. Copy to .env (git-ignored) and
# fill in. DB_HOST, DB_USER and DB_PASSWORD are required, and the gateway JWT
# settings unless AUTH_DISABLED=true. Never commit real values.

# --- Required ---------------------------------------------------------------
# MySQL host of the legacy schemas (allocation_db and travelapp read/write,
# expense_app read-only). One user for all three.
DB_HOST=
DB_USER=
DB_PASSWORD=

# --- Callers (gateway JWT) ----------------------------------------------------
# A local run with the backend on localhost: no gateway, so skip the check.
# The server then listens on 127.0.0.1 only.
AUTH_DISABLED=true
# A local database without the audit_event tables.
# AUDIT_OPTIONAL=true
# Deployed: the gateway's JWKS and the client ids let in (the backend's
# OUTBOUND_CLIENT_ID), comma-separated.
# GATEWAY_JWT_JWKS_URL=
# GATEWAY_JWT_ISSUER=wso2.org/products/am
# ALLOWED_CLIENT_IDS=
# CLIENT_ID_CLAIMS=
# GATEWAY_JWT_API_CONTEXTS=
# API_CONTEXT_CLAIMS=

# --- Optional (defaults shown) ------------------------------------------------
# DB_PORT=3306
# Empty = verified TLS. Set false only for a local MySQL without TLS;
# skip-verify is for non-production only.
# DB_TLS=
# A MySQL certificate from an internal CA: the CA bundle (PEM) and, when
# DB_HOST is an IP, the host name the certificate carries.
# DB_TLS_CA=
# DB_TLS_SERVER_NAME=
# SERVER_PORT=8290

# --- NetSuite (only when switched on) -----------------------------------------
# Off: invoice and per diem pushes and re-syncs answer 503, entry duplicate
# checks skip NetSuite, and a new Marketing Event is saved without a NetSuite
# marketing event (a warning is logged).
# NETSUITE_PUSH_ENABLED=false
# NETSUITE_ACCOUNT_ID=
# NETSUITE_CONSUMER_KEY=
# NETSUITE_CONSUMER_SECRET=
# NETSUITE_TOKEN_ID=
# NETSUITE_TOKEN_SECRET=
# NETSUITE_PURCHASE_ORDER_TAX_CODE=
# NETSUITE_CREATE_PURCHASE_ORDER_SCRIPT_ID=
# NETSUITE_GET_PURCHASE_ORDER_SCRIPT_ID=
# NETSUITE_CREATE_VENDOR_BILL_SCRIPT_ID=
# NETSUITE_GET_VENDOR_BILL_SCRIPT_ID=
# NETSUITE_CREATE_MARKETING_EVENT_SCRIPT_ID=
# Optional: NETSUITE_RESTLETS_BASE_URL (default from the account id) and
# NETSUITE_*_DEPLOY_ID for each script (default 1).
